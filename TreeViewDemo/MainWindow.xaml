<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TreeViewDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TreeViewDemo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:treeView="using:Syncfusion.UI.Xaml.TreeView"
    mc:Ignorable="d"
    Title="TreeViewDemo">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <!-- Component Header -->
            <DataTemplate x:Key="treeDescComponentTemplate">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                     Text="{Binding ComponentNameLong}"
                     Margin="5"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Width="150"
                     FontWeight="Bold" />
                </StackPanel>
            </DataTemplate>

            <!-- Detail Row -->
            <DataTemplate x:Key="treeDescDetailTemplate">
                <StackPanel Orientation="Horizontal" >
                    <FontIcon
                     Height="50"
                     Margin="0,0,4,0"
                     VerticalAlignment="Center"
                     FontFamily="FluentSystemIcons-Resizable"
                     Glyph="{Binding IconGlyph}" />

                    <TextBlock
                     Text="{Binding Category}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     Width="150"
                     Margin="2"
                     FontWeight="Bold" />

                    <TextBlock
                     Text="{Binding Detail}"
                     Margin="2"
                     Width="150"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     FontWeight="SemiBold" />

                    <TextBlock
                     Text="{Binding Value}"
                     Margin="2"
                     Width="150"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     ToolTipService.ToolTip="{Binding Value}" />
                </StackPanel>
            </DataTemplate>

            <!-- Template Selector -->
            <local:ItemTemplateSelector
         x:Key="itemTemplateSelectorTreeDesc"
         CompHeaderTemplate="{StaticResource treeDescComponentTemplate}"
         DetailTemplate="{StaticResource treeDescDetailTemplate}" />
        </Grid.Resources>
        
        <treeView:SfTreeView
         x:Name="treeView"
         ItemsSource="{x:Bind ViewModel.GroupedJobDescription, Mode=OneWay}"
         ChildPropertyName="Details"
         AutoExpandMode="AllNodes"
         Indentation="6"
         IsAnimationEnabled="True"
         ItemTemplateDataContextType="Item"
         ItemTemplateSelector="{StaticResource itemTemplateSelectorTreeDesc}"
         HorizontalAlignment="Stretch"
         VerticalAlignment="Stretch"
         ScrollViewer.HorizontalScrollBarVisibility="Auto"
         QueryNodeSize="treeView_QueryNodeSize"/>
    </Grid>
</Window>
